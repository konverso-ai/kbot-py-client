[MAIN]
ignore=CVS,.git,.ruff_cache,.venv
jobs=1
load-plugins=pylint.extensions.no_self_use
persistent=yes
unsafe-load-any-extension=no

[MESSAGES CONTROL]
# Active toutes les règles (logique, typage, structure), sauf celles désactivées
# ci-dessous. `enable` doit précéder `disable` pour que ces exclusions s'appliquent.
enable=all
disable=
    invalid-name,
    fixme,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    bare-except,
    broad-except,
    no-self-use,
    too-few-public-methods,
    too-many-public-methods,
    too-many-instance-attributes,
    too-many-nested-blocks,
    too-many-statements,
    too-many-return-statements,
    unused-argument,
    too-many-ancestors,
    wildcard-import,
    abstract-method,
    missing-docstring

[TYPECHECK]
ignore-mixin-members=yes

[FORMAT]
# Déjà géré par Ruff
max-line-length=88

[REPORTS]
evaluation=10.0 - ((float(5 * error + warning + refactor + convention) / statement) * 10)
output-format=colorized
reports=yes
score=yes

[DESIGN]
max-args=10
max-attributes=10
max-branches=12
max-locals=15
max-returns=6
max-statements=50
max-public-methods=20
